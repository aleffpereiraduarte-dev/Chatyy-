package main

import (
	"encoding/base64"
	"net"
	"os"
	"os/exec"
	"path/filepath"
	"strconv"
	"strings"
	"testing"
)

func TestXJniHarness(t *testing.T) {
	cp := os.Getenv("JNI_CP")
	if cp == "" {
		t.Skip("JNI_CP")
	}
	e := newQNEnv(t)
	addr := e.addr().(*net.UDPAddr)
	af := filepath.Join(e.dir, "auth.json")
	os.WriteFile(af, []byte(authFrame("apitest@onemundo.com.br")), 0o600)
	out, err := exec.Command("java", "-cp", cp, "JniMain", os.Getenv("JNI_SO"), strconv.Itoa(addr.Port),
		base64.StdEncoding.EncodeToString(e.srvKey.Public), af).CombinedOutput()
	t.Log("\n" + string(out))
	if err != nil {
		t.Fatal(err)
	}
	for _, w := range []string{"keypair 64", "bad_ip 0", "bad_key 0", "stale_send false", "auth_success", "migrate true", "chat_send_ack", "CLOSED code=1000", "GONE", "after_free_poll 6", "DONE"} {
		if !strings.Contains(string(out), w) {
			t.Errorf("faltou %q", w)
		}
	}
}
