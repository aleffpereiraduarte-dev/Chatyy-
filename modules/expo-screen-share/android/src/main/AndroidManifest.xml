<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    [2026-05-16] MediaProjection foreground service for Android screenshare.
    Android 14+ requires this declared permission AND foregroundServiceType
    in startForeground() (see ScreenShareService.kt). Without both, the
    service throws SecurityException the moment we acquire the MediaProjection.
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

  <application>
    <service
      android:name=".ScreenShareService"
      android:exported="false"
      android:foregroundServiceType="mediaProjection" />
  </application>
</manifest>
