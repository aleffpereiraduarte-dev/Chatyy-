<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.livenative" >

    <uses-sdk android:minSdkVersion="26" />

    <application>

        <!--
      Stage 1 scaffold (2026-05-16) — full-native Live host screen. Owns the
      entire broadcast UX: camera preview + LiveKit publish + viewer count +
      reactions. Replaces the RN /live-broadcast screen once Stage 2 lands.
      portrait + NoActionBar so the activity owns its own chrome.
        -->
        <activity
            android:name="expo.modules.livenative.LiveHostActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <!--
      Stage 1 scaffold — Live viewer screen. Subscribes to the host's video +
      audio tracks; sends like reactions over the data channel. Replaces the
      RN /live-viewer screen once Stage 2 lands.

      Wave 16 (2026-05-17): supportsPictureInPicture=true so onUserLeaveHint
      can drop the activity into a floating PiP window when the user
      backgrounds the app. resizeableActivity=true is required for PiP on
      Android 8.0 (API 26)+. The activity also handles screen+keyboard
      config changes itself so PiP entry doesn't recreate the activity.
        -->
        <activity
            android:name="expo.modules.livenative.LiveViewerActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden"
            android:exported="false"
            android:resizeableActivity="true"
            android:screenOrientation="portrait"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
    </application>

</manifest>