<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    CAMERA + RECORD_AUDIO are already declared by the host app's manifest
    (com.onemundo.mail). We re-declare them here just so the lint check inside
    the library module is happy; manifest merger dedups at build time.
  -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <uses-feature android:name="android.hardware.camera.front" android:required="false" />
  <uses-feature android:name="android.hardware.microphone" android:required="false" />

  <application>
    <activity
      android:name=".LiveHostActivity"
      android:exported="false"
      android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
      android:screenOrientation="portrait"
      android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
      android:launchMode="singleTop"
      android:taskAffinity="" />

    <activity
      android:name=".LiveViewerActivity"
      android:exported="false"
      android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
      android:screenOrientation="portrait"
      android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
      android:launchMode="singleTop"
      android:taskAffinity="" />
  </application>
</manifest>
