<?xml version="1.0" encoding="utf-8"?>
<!-- [2026-10-09 system-integration] RemoteViews-safe layout (LinearLayout/TextView/ImageView only). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/chatyy_w_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/chatyy_widget_bg"
  android:orientation="vertical"
  android:padding="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <TextView
      android:id="@+id/chatyy_w_header"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="Chatyy"
      android:textColor="@color/chatyy_widget_fg"
      android:textSize="16sp"
      android:textStyle="bold" />
    <ImageView
      android:id="@+id/chatyy_w_new"
      android:layout_width="28dp"
      android:layout_height="28dp"
      android:contentDescription="@string/chatyy_widget_new_chat"
      android:padding="2dp"
      android:src="@drawable/chatyy_widget_ic_new" />
  </LinearLayout>



  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="6dp"
    android:orientation="vertical">
    <TextView
      android:id="@+id/chatyy_w_empty"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center"
      android:text="@string/chatyy_widget_empty"
      android:textColor="@color/chatyy_widget_fg_muted"
      android:textSize="13sp"
      android:visibility="visible" />
    <LinearLayout
      android:id="@+id/chatyy_w_row1"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingTop="2dp"
      android:paddingBottom="2dp"
      android:visibility="gone">
      <ImageView
        android:id="@+id/chatyy_w_avatar1"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />
      <TextView
        android:id="@+id/chatyy_w_name1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/chatyy_widget_fg"
        android:textSize="14sp" />
      <TextView
        android:id="@+id/chatyy_w_badge1"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/chatyy_widget_badge"
        android:gravity="center"
        android:minWidth="20dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="@color/chatyy_widget_badge_text"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/chatyy_w_row2"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingTop="2dp"
      android:paddingBottom="2dp"
      android:visibility="gone">
      <ImageView
        android:id="@+id/chatyy_w_avatar2"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />
      <TextView
        android:id="@+id/chatyy_w_name2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/chatyy_widget_fg"
        android:textSize="14sp" />
      <TextView
        android:id="@+id/chatyy_w_badge2"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/chatyy_widget_badge"
        android:gravity="center"
        android:minWidth="20dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="@color/chatyy_widget_badge_text"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/chatyy_w_row3"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingTop="2dp"
      android:paddingBottom="2dp"
      android:visibility="gone">
      <ImageView
        android:id="@+id/chatyy_w_avatar3"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />
      <TextView
        android:id="@+id/chatyy_w_name3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/chatyy_widget_fg"
        android:textSize="14sp" />
      <TextView
        android:id="@+id/chatyy_w_badge3"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/chatyy_widget_badge"
        android:gravity="center"
        android:minWidth="20dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="@color/chatyy_widget_badge_text"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/chatyy_w_row4"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingTop="2dp"
      android:paddingBottom="2dp"
      android:visibility="gone">
      <ImageView
        android:id="@+id/chatyy_w_avatar4"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />
      <TextView
        android:id="@+id/chatyy_w_name4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/chatyy_widget_fg"
        android:textSize="14sp" />
      <TextView
        android:id="@+id/chatyy_w_badge4"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/chatyy_widget_badge"
        android:gravity="center"
        android:minWidth="20dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="@color/chatyy_widget_badge_text"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
