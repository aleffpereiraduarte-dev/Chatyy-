<?xml version="1.0" encoding="utf-8"?>
<!--
  [#1176 polish, 2026-05-18] Slide-up enter animation for CallActivity /
  GroupCallActivity. Mirrors the iOS modal-sheet "slide up from bottom"
  feel so the transition between the chat screen and the native call
  surface reads as a deliberate "this is a new mode" rather than the
  default whoosh-from-right. 280ms is the same duration WhatsApp uses
  on outgoing calls; long enough to register as intentional, short
  enough not to delay the user's perception of the call starting.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quint"
    android:shareInterpolator="true">
    <translate
        android:fromYDelta="100%p"
        android:toYDelta="0"
        android:duration="280" />
    <alpha
        android:fromAlpha="0.6"
        android:toAlpha="1.0"
        android:duration="220" />
</set>
