<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
  <!--
    [2026-05-16 Stage 4] FOREGROUND_SERVICE_DATA_SYNC for RelayWakeService.
    Required by Android 14+ when starting a foregroundServiceType=dataSync
    service from background (FCM-triggered silent wake). Without this the
    OS throws SecurityException and the service is killed immediately.
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

  <application>

    <activity
      android:name=".IncomingCallActivity"
      android:exported="false"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:taskAffinity=""
      android:excludeFromRecents="true"
      android:launchMode="singleInstance"
      android:theme="@style/Theme.AppCompat.NoActionBar"
      android:screenOrientation="portrait" />

    <!--
      Day 1 scaffold (2026-05-15) — full-native in-call screen that replaces
      React Native /call.js. Owns the entire call UX. singleTop so a second
      openNativeCall() while one is already running reuses the same instance.
    -->
    <activity
      android:name=".CallActivity"
      android:exported="false"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:taskAffinity=""
      android:excludeFromRecents="true"
      android:launchMode="singleTop"
      android:supportsPictureInPicture="true"
      android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
      android:theme="@style/Theme.AppCompat.NoActionBar"
      android:screenOrientation="portrait" />

    <!--
      [2026-05-16] Group-call scaffold — sibling of CallActivity for N-way
      LiveKit rooms (chat group voice/video). Mirrors the singleTop /
      PiP-capable / portrait / NoActionBar flags so multi-launch reuses the
      same instance and the activity can shrink into PiP for video group
      calls. Owner: openGroupCall AsyncFunction in ExpoCallKitModule.
    -->
    <activity
      android:name=".GroupCallActivity"
      android:exported="false"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:taskAffinity=""
      android:excludeFromRecents="true"
      android:launchMode="singleTop"
      android:supportsPictureInPicture="true"
      android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
      android:theme="@style/Theme.AppCompat.NoActionBar"
      android:screenOrientation="portrait" />

    <!--
      [Stage 998/1000 — 2026-05-17] Compose-based Live Broadcast host
      activity. Owns the LiveKit publisher Room + the WS connection for
      live_* events. Same flags as CallActivity (singleTop so re-tapping a
      live during one already running reuses the activity; portrait; no
      action bar; exported=false because JS launches it via the module
      bridge, never via implicit intent).
    -->
    <activity
      android:name=".LiveBroadcastActivity"
      android:exported="false"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:taskAffinity=""
      android:excludeFromRecents="true"
      android:launchMode="singleTop"
      android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
      android:theme="@style/Theme.AppCompat.NoActionBar"
      android:screenOrientation="portrait" />

    <!--
      [Stage 998/1000 — 2026-05-17] Compose-based Live Viewer audience
      activity. Subscribe-only LK Room + WS for live_* events. Auto-closes
      on live_viewer_kicked carrying the local user's email.
    -->
    <activity
      android:name=".LiveViewerActivity"
      android:exported="false"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:taskAffinity=""
      android:excludeFromRecents="true"
      android:launchMode="singleTop"
      android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
      android:theme="@style/Theme.AppCompat.NoActionBar"
      android:screenOrientation="portrait" />

    <receiver
      android:name=".CallActionReceiver"
      android:exported="false" />

    <!--
      [notif-p0p1 2026-05-17] Chat notification actions. Backs MessagingStyle
      inline RemoteInput (quick reply), mark-as-read, mute 8h, snooze 1h.
      Explicit intent actions (setPackage in sender) so no permission/export.
    -->
    <receiver
      android:name=".ChatActionReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="com.onemundo.mail.ACTION_CHAT_REPLY" />
        <action android:name="com.onemundo.mail.ACTION_CHAT_MARK_READ" />
        <action android:name="com.onemundo.mail.ACTION_CHAT_MUTE_8H" />
        <action android:name="com.onemundo.mail.ACTION_CHAT_SNOOZE_1H" />
        <action android:name="com.onemundo.mail.ACTION_CHAT_SMART_REPLY" />
        <action android:name="com.onemundo.mail.ACTION_CALL_BACK" />
      </intent-filter>
    </receiver>

    <!--
      CRITICAL: priority="10" ensures this service receives FCM messages
      BEFORE Expo's ExpoFirebaseMessagingService (which uses priority="-1").
      Android only delivers to ONE FirebaseMessagingService — the highest priority one.
      We handle call messages ourselves and delegate everything else to Expo's handler.
    -->
    <service
      android:name=".CallFirebaseMessagingService"
      android:exported="false">
      <intent-filter android:priority="10">
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>

    <!--
      Foreground service for incoming call ringing.
      Required on Android 12+ to keep the process alive and show full-screen UI
      when the app is killed. Type "phoneCall" is required on Android 14+.
    -->
    <service
      android:name=".CallRingingService"
      android:exported="false"
      android:foregroundServiceType="phoneCall" />

    <!--
      [2026-05-16] Foreground service for IN-PROGRESS calls (post-accept).
      Distinct from CallRingingService: this one uses a LOW-importance
      channel ("chatyy_calls_ongoing"), silent, persistent — its only job
      is to keep the process alive while the user has the app backgrounded
      mid-conversation (swipe home → LiveKit Room WS would otherwise die).
      foregroundServiceType MUST be "phoneCall" (not "dataSync") because we
      ARE in an active call and hold the mic; Android 14+ enforces the
      type-to-permission mapping (FOREGROUND_SERVICE_PHONE_CALL).
    -->
    <service
      android:name=".CallOngoingService"
      android:exported="false"
      android:foregroundServiceType="phoneCall" />

    <!--
      [2026-05-16 Stage 4] Silent push wake → raw WebSocket session. Started
      from CallFirebaseMessagingService.onMessageReceived when an FCM
      payload arrives with `type: "wake_relay"`. foregroundServiceType is
      `dataSync` because we are NOT placing a call — we are syncing data
      so another device (web companion) can read it. Android 14+ requires
      this exact type and the matching FOREGROUND_SERVICE_DATA_SYNC
      permission (declared above). No UI: see RelayWakeService.kt.
    -->
    <service
      android:name=".RelayWakeService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />

    <!--
      [Telecom integration, 2026-05-17] InCallService scaffold so Chatyy
      shows up in Settings → Calling Accounts and the stock dialer's
      Recents tab can attribute calls to us. The matching ConnectionService
      will land in a follow-up — until then this is enough to register the
      PhoneAccountHandle and expose Chatyy as a calling app. See
      ChatyyInCallService.kt for the full architecture comment.

      BIND_INCALL_SERVICE permission lets the system bind us when a call
      tied to our PhoneAccountHandle is active. The intent-filter is the
      contract the framework expects on this service class.
    -->
    <service
      android:name=".ChatyyInCallService"
      android:exported="true"
      android:permission="android.permission.BIND_INCALL_SERVICE">
      <meta-data
        android:name="android.telecom.IN_CALL_SERVICE_UI"
        android:value="false" />
      <intent-filter>
        <action android:name="android.telecom.InCallService" />
      </intent-filter>
    </service>

  </application>

</manifest>
