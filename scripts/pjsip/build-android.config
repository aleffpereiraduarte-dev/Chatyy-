# build-android.config — sourced by scripts/pjsip/build-android.sh
# Mirrors scripts/pjsip/build-ios.config from Agent 6.
#
# Adjust these knobs only if you understand the consequences. Bumping
# PJSIP_VERSION requires re-validating the consumer-rules.pro (R8) and
# the SWIG-generated org.pjsip.pjsua2 binding ABI.

# ---- PJSIP / PJPROJECT -----------------------------------------------------
PJSIP_VERSION="2.14.1"
PJSIP_GIT_URL="https://github.com/pjsip/pjproject.git"
PJSIP_GIT_TAG="${PJSIP_VERSION}"

# ---- External codec / TLS deps (built once, cached per ABI) ----------------
OPENSSL_VERSION="3.0.13"        # static, --no-shared
OPUS_VERSION="1.4"              # static, --disable-shared
SRTP_VERSION="2.5.0"            # static (libsrtp2)

# ---- Android NDK -----------------------------------------------------------
# We pin to the same NDK the self-host runner uses (see MEMORY
# android_self_host_runner). Override by exporting ANDROID_NDK_ROOT before
# calling build-android.sh.
NDK_VERSION_REQUIRED="27.1.12297006"
ANDROID_API_MIN=24              # Android 7.0 — matches app.json minSdkVersion
ANDROID_API_TARGET=34           # build host target (NDK toolchain)

# ABIs to produce. Order matters: arm64-v8a first so smoke-tests fail fast.
# x86_64 is mandatory per android_emul_state_2026_05_15 (emul-5554/5556 QA).
ANDROID_ABIS=("arm64-v8a" "armeabi-v7a" "x86_64")

# ---- Output ----------------------------------------------------------------
OUTPUT_AAR_NAME="pjsip-${PJSIP_VERSION}.aar"
OUTPUT_DIR="${REPO_ROOT}/vendor/pjsip-android"

# AAR package coordinates (used by the AndroidManifest.xml stub we emit)
AAR_PACKAGE="org.pjsip.android"
AAR_VERSION_NAME="${PJSIP_VERSION}"

# ---- ccache (optional but strongly recommended) ----------------------------
# Set CCACHE_DISABLE=1 in env to skip. Default cache dir lives next to the
# build tree so it survives between runs and is isolated from any user-level
# ccache config.
CCACHE_BIN="$(command -v ccache 2>/dev/null || true)"
CCACHE_DIR_DEFAULT="${REPO_ROOT}/vendor/pjsip-android/.ccache"

# ---- PJSIP feature flags ---------------------------------------------------
# Disabled to shrink the .so footprint. Match the iOS build's exclusions so
# both platforms ship the same codec set.
PJSIP_DISABLE_FEATURES=(
  "--disable-video"        # we re-enable selectively via pjsua-android-config.h
  "--disable-g711-codec"   # we keep PCMU only, via config header
  "--disable-l16-codec"
  "--disable-gsm-codec"
  "--disable-g722-codec"
  "--disable-g7221-codec"
  "--disable-speex-codec"
  "--disable-speex-aec"    # we use WebRTC AEC3 instead
  "--disable-ilbc-codec"
  "--disable-libyuv"
  "--disable-ffmpeg"
  "--disable-v4l2"
  "--disable-sdl"
  "--disable-openh264"
  "--disable-libwebrtc"    # we build webrtc-aec3 separately, smaller
)

# Features we *want* enabled.
PJSIP_ENABLE_FEATURES=(
  "--with-ssl=\${OPENSSL_PREFIX}"
  "--with-opus=\${OPUS_PREFIX}"
  "--enable-libsrtp"
  "--enable-epoll"
)

# ---- Build flavor ----------------------------------------------------------
# release = -O2, debug-symbols stripped via llvm-strip -x
# debug   = -O0 -g, no strip (do NOT ship)
PJSIP_FLAVOR="${PJSIP_FLAVOR:-release}"
