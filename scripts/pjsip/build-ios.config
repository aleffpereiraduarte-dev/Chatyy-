# -----------------------------------------------------------------------------
# build-ios.config — env vars sourced by build-ios.sh
# Edit these on Mac 207. Do NOT commit secrets here (these are paths only).
# -----------------------------------------------------------------------------

# PJSIP source tag + repo. Pinned for reproducible builds.
export PJSIP_TAG="2.14.1"
export PJSIP_REPO="https://github.com/pjsip/pjproject"

# Minimum iOS deployment target. MUST match Podfile platform :ios.
export MIN_IOS="15.1"

# Dependency paths (static libs we link into the final XCFramework).
# Build OpenSSL via `scripts/pjsip/build-deps.sh openssl` (TBD next phase) or
# point at an existing build. We use OpenSSL 3.0.x LTS.
#
# Layout expected:
#   ${OPENSSL_PATH}/include/openssl/*.h
#   ${OPENSSL_PATH}/lib/{libssl.a,libcrypto.a}  (FAT — all 3 slices)
#
# Mac 207 default: ~/build-deps/openssl-ios-3.0.13
export OPENSSL_PATH="${OPENSSL_PATH:-${HOME}/build-deps/openssl-ios-3.0.13}"

# Opus 1.4 — built from upstream xiph/opus tag v1.4 with ios toolchain.
# Layout expected:
#   ${OPUS_PATH}/include/opus/*.h
#   ${OPUS_PATH}/lib/libopus.a  (FAT)
export OPUS_PATH="${OPUS_PATH:-${HOME}/build-deps/opus-ios-1.4}"

# Parallel jobs (default = ncpu). Override on shared Mac 207 if needed.
# export JOBS=4

# ccache (massive speedup on rebuilds). brew install ccache.
export USE_CCACHE="${USE_CCACHE:-1}"
# export CCACHE_DIR="${HOME}/.ccache/pjsip"

# Extra configure flags appended to ./configure-iphone. Leave empty unless
# you know what you're doing. Examples:
#   --disable-sound        # use audio device API only via custom port
#   --disable-resample     # skip if you ship your own resampler
export EXTRA_CONFIGURE_FLAGS=""

# Output paths (relative to repo root). Usually no need to override.
# export SRC_DIR="${REPO_ROOT}/vendor/pjsip-src"
# export OUT_DIR="${REPO_ROOT}/vendor/pjsip-ios"
# export BUILD_DIR="${REPO_ROOT}/vendor/pjsip-ios/.build"
