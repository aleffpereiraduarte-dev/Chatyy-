# /etc/chatyy-router/env (0640 root:chatyy-router). SEM segredos aqui. Gerado pelo subir.sh.
ROUTER_WG_IP=10.8.0.7
ROUTER_DIST_PORT=4370
ROUTER_REGION=br2
ROUTER_REGIONS=br=router@10.8.0.2,br2=router@10.8.0.7,scl=router@10.8.0.11,mia=router@10.8.0.8,mex=router@10.8.0.9,usw=router@10.8.0.4,sg=router@10.8.0.5,in=router@10.8.0.6,eu=router@10.8.0.3,mad=router@10.8.0.10
ROUTER_SISTERS=br=br2,scl;br2=br,scl;scl=br2,br;mia=usw,mex;mex=usw,mia;usw=mia,mex;sg=in,usw;in=sg,eu;eu=mad,br;mad=eu,mia
# quórum: padrão = maioria (10 regiões → 6)
ROUTER_ACK_MODE=sister
ROUTER_FSYNC=always
ROUTER_STORE=disc
ROUTER_LOG_DIR=/var/lib/chatyy-router/log
ROUTER_LOG_MAX_MB=10240
ROUTER_FAILOVER_MS=60000
ROUTER_CTL_PORT=4790
ROUTER_FLAGS_FILE=/etc/chatyy-router/flags
ROUTER_SCHEDULERS=2
ROUTER_HUB_URL=http://127.0.0.1:8086
