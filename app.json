{
  "expo": {
    "name": "Chatyy",
    "slug": "webmail-app",
    "version": "2.3.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "onemundomail",
    "owner": "aleffduarte",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 5000,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/7175af93-5113-4bd7-85d7-1ae78e5762b4"
    },
    "splash": {
      "image": "./assets/splash-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.onemundo.mail",
      "buildNumber": "306",
      "googleServicesFile": "./GoogleService-Info.plist",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Chatyy needs your camera for video calls and to scan QR codes for device pairing.",
        "NSMicrophoneUsageDescription": "Chatyy needs your microphone so others can hear you during voice and video calls.",
        "NSContactsUsageDescription": "Chatyy accesses your contacts to find people you know and start conversations.",
        "NSCalendarsUsageDescription": "Chatyy accesses your calendar to sync and manage your events.",
        "NSCalendarsFullAccessUsageDescription": "Chatyy accesses your calendar to sync and manage your events.",
        "NSPhotoLibraryUsageDescription": "Chatyy accesses your photos to send media in chats and backup your photos to the cloud.",
        "NSPhotoLibraryAddUsageDescription": "Chatyy saves files to your photo library when you download attachments.",
        "NSLocationWhenInUseUsageDescription": "Chatyy accesses your location when you tap Share Location in a chat.",
        "NSFaceIDUsageDescription": "Chatyy uses Face ID to securely unlock the app.",
        "UIBackgroundModes": [
          "remote-notification",
          "fetch",
          "voip",
          "audio",
          "processing"
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "mailto"
            ],
            "CFBundleURLName": "com.onemundo.mail.mailto"
          }
        ]
      }
    },
    "android": {
      "package": "com.onemundo.mail",
      "versionCode": 223,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://chatyy.com.br"
        }
      ],
      "expo-splash-screen",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563eb",
          "sounds": [
            "./assets/ringtone.wav"
          ]
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Chatyy accesses your contacts to find people you know."
        }
      ],
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "Chatyy accesses your calendar to sync events."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Chatyy accesses your photos to send media.",
          "cameraPermission": "Chatyy needs your camera to take photos."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Chatyy accesses your location to share in chat.",
          "locationWhenInUsePermission": "Chatyy accesses your location to share in chat."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Chatyy accesses your media library for photo backup.",
          "savePhotosPermission": "Chatyy saves media to your gallery."
        }
      ],
      "expo-background-fetch",
      "expo-task-manager",
      [
        "expo-camera",
        {
          "cameraPermission": "Chatyy needs your camera to scan QR codes and take photos."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Chatyy needs your camera for video calls.",
          "microphonePermission": "Chatyy needs your microphone for voice and video calls."
        }
      ],
      "./plugins/fix-jitpack",
      "./plugins/voip-push",
      "expo-asset",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Chatyy uses Face ID to securely unlock the app."
        }
      ],
      "expo-background-task",
      "expo-image",
      "expo-speech-recognition",
      "expo-audio",
      "expo-video"
    ],
    "extra": {
      "router": {
        "origin": "https://chatyy.com.br"
      },
      "eas": {
        "projectId": "7175af93-5113-4bd7-85d7-1ae78e5762b4"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
